{
  "name": "@lumenlabs/lumen-brain",
  "version": "2.0.0",
  "description": "TypeScript SDK for BrainAPI v2",
  "license": "MIT",
  "author": "Lumen Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lumen-Labs/lumen-brain-node.git"
  },
  "homepage": "https://github.com/Lumen-Labs/lumen-brain-node",
  "bugs": {
    "url": "https://github.com/Lumen-Labs/lumen-brain-node/issues"
  },
  "keywords": [
    "brainapi",
    "lumen",
    "knowledge-graph",
    "memory",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.9"
  }
}
